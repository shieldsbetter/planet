{
    "name": "@shieldsbetter/planet",
    "version": "0.1.0",
    "description": "Procedural planet generator: a spinning, lit, cloud-covered planet on a canvas.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/shieldsbetter/planet.git"
    },
    "main": "planet.js",
    "exports": {
        ".": {
            "import": "./planet.mjs",
            "require": "./planet.js"
        },
        "./planet.js": "./planet.js"
    },
    "files": [
        "planet.js",
        "planet.mjs"
    ],
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --max-warnings 0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "eslint-plugin-perfectionist": "^5.14.0",
        "globals": "^17.14.0",
        "prettier": "^3.10.1"
    }
}
